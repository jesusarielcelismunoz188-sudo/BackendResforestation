# Base de datos propia de la aplicación (no se usa Supabase Auth para estos datos).
DATABASE_URL=postgresql://usuario:password@localhost:5432/reforestacion

# Supabase se usa exclusivamente para autenticación.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_local_key
SUPABASE_STORAGE_BUCKET=reforestacion-archivos
STORAGE_MAX_FILE_SIZE_BYTES=10485760
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# Orígenes del frontend separados por coma. En producción, usa solo dominios de confianza.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
